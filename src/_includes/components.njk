{% macro levelBadge(level) %}<span class="level level-{{ level }}"><span aria-hidden="true">●</span> {{ {'L1':'入门','L2':'进阶','L3':'精读'}[level] }}</span>{% endmacro %}
{% macro tags(tags, linked=true) %}<div class="tag-list" aria-label="知识域标签">{% for tag in tags %}{% if linked %}<a class="tag-chip" href="{{ '/terms/' | url }}?tag={{ tag | urlencode }}">{{ tag }}</a>{% else %}<span class="tag-chip">{{ tag }}</span>{% endif %}{% endfor %}</div>{% endmacro %}
{% macro appHeader(seriesItems) %}
<header class="app-bar" id="top"><div class="container bar-inner"><a class="brand" href="{{ '/' | url }}" aria-label="金融知识故事站首页"><span class="brand-mark" aria-hidden="true">知</span><span>金融知识故事站</span></a><nav aria-label="主导航"><a href="{{ '/' | url }}">首页</a><details class="series-menu"><summary>系列</summary><div>{% for item in seriesItems %}<a href="{{ ('/series/' + item.slug + '/') | url }}">{{ item.title }}</a>{% endfor %}</div></details><a href="{{ '/terms/' | url }}">索引</a></nav><button class="theme-toggle" type="button" data-theme-toggle aria-label="切换到深色主题" aria-pressed="false"><span data-theme-label>深色</span><span aria-hidden="true" data-theme-icon>☾</span></button></div></header>
{% endmacro %}
{% macro storyCard(story, seriesItems) %}
<article class="story-card {% if story.planned %}planned{% endif %}" data-story data-scene="{{ story.seriesSlug }}" data-tags="{{ story.tags | join(',') }}" data-difficulty="{{ story.level }}">
<div class="card-meta"><a class="scene-chip" href="{{ ('/series/' + story.seriesSlug + '/') | url }}">{{ (seriesItems | bySlug(story.seriesSlug)).title }}</a>{{ levelBadge(story.level) }}</div>
{% if story.planned %}<h3>{{ story.title }}</h3><p class="coming-label">大纲预告 · 正文待供稿</p>{% else %}<h3><a href="{{ story.url | url }}">{{ story.title }}</a></h3>{% endif %}<p>{{ story.hook }}</p>{{ tags(story.tags) }}</article>
{% endmacro %}
{% macro filterBar(scene='', index=false, seriesItems=[], tagItems=[]) %}
<section class="filter-panel" aria-labelledby="filter-heading"><form class="filter-bar" data-filter-form action="{{ ('/terms/' if index else '/series/' + scene + '/') | url }}">
<div class="filter-panel-head"><h2 id="filter-heading">按三轴筛选</h2>{% if index %}<label class="term-search"><span>搜索</span><input type="search" name="q" data-term-search placeholder="术语、释义或故事" autocomplete="off" enterkeyhint="search"></label>{% endif %}</div>
{% if index %}<div class="filter-group"><span class="filter-label" id="scene-label">场景</span><div class="chips" role="group" aria-labelledby="scene-label"><button type="button" data-scene="" aria-pressed="true" class="chip selected">全部</button>{% for item in seriesItems %}<button type="button" data-scene="{{ item.slug }}" aria-pressed="false" class="chip">{{ item.title }}</button>{% endfor %}</div></div><input type="hidden" name="scene" value="">{% else %}<div class="filter-group"><span class="filter-label">场景</span><span class="chip selected locked" aria-label="场景已锁定">✓ {{ (seriesItems | bySlug(scene)).title }}</span><input type="hidden" name="scene" value="{{ scene }}"></div>{% endif %}
<div class="filter-group"><span class="filter-label" id="tag-label">标签 <span class="small">可多选 · OR</span></span><div class="chips" role="group" aria-labelledby="tag-label">{% for item in tagItems %}<button type="button" class="chip" data-tag="{{ item.id }}" aria-pressed="false">{{ item.id }}</button>{% endfor %}</div></div>
<fieldset class="level-filter"><legend>难度</legend><div class="segmented"><label><input type="radio" name="difficulty" value="" checked><span>全部</span></label><label><input type="radio" name="difficulty" value="L1"><span>入门</span></label><label><input type="radio" name="difficulty" value="L2"><span>进阶</span></label><label><input type="radio" name="difficulty" value="L3"><span>精读</span></label></div></fieldset>
<div class="filter-actions"><span data-selection-summary>全部故事</span><button class="text-button" type="button" data-clear-filters>清除筛选</button></div><noscript><button type="submit">应用筛选（无 JavaScript 降级需刷新）</button></noscript>
</form><div class="result-line" role="status" aria-live="polite"><strong data-result-count>0</strong> 个结果 <span class="small">筛选状态已保存在网址，可分享或刷新</span></div></section>
{% endmacro %}
